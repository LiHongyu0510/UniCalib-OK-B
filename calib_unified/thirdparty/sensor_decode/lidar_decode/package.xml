<?xml version="1.0"?>
<package format="2">
  <name>lidar_decode</name>
  <version>0.0.0</version>
  <description>The lidar_decode package</description>
  <maintainer email="bill@citygo.com.cn">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <!-- PCL C++ headers/libs (pcl/conversions.h, pcl::io::*) — rosdep key "pcl" -> libpcl-dev -->
  <build_depend>pcl</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>pcl</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

